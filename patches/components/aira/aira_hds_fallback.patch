index 0000000..f004192
--- /dev/null
+++ b/AiraBrowser/entry/src/main/ets/platform/huawei/OpenHarmonyHdsMaterialShim.ets
@@ -0,0 +1,53 @@
+/*
+ * [fix_input_aira] OpenHarmony 兼容垫片：HMS HDS（@kit.UIDesignKit）在 OpenHarmony 上不存在。
+ *
+ * 现象（真机 / QEMU 均可复现）：
+ *   打开 Aira 的「数据同步 → 自建」页面时进程被杀（reason=Js Error）。
+ *   原因：该页面用的 SettingsHdsScaffold 静态导入了 @kit.UIDesignKit 的
+ *   HdsNavDestination / HdsTabs 等 **ArkUI 组件**。OpenHarmony 设备上没有 HMS 的
+ *   HDS 运行库（out/ptl 里没有任何 hds 库），运行时加载这些模块会失败：
+ *       E C03f00/ArkCompiler: Load native module entry is not a JSObject
+ *   组件在 build() 里被调用时抛 TypeError（未捕获）→ ArkUI 渲染中断 → 应用被杀。
+ *
+ * 修法：把 HDS 的依赖从应用里彻底拿掉。
+ *   1) 材质能力（hdsMaterial）改用本地垫片，getSystemMaterialTypes() 恒返回空数组
+ *      → 应用自带的 isHdsMaterialAvailable() 判定为「不可用」→ 走应用本来就有的
+ *      普通 ArkUI 降级路径（这个降级路径本来就是为非 HMS 设备写的）。
+ *   2) HdsNavDestination / HdsTabs 这类**组件**无法用垫片等价实现，改为普通 ArkUI
+ *      组件（标题栏 / 面板），视觉效果退化为无毛玻璃，但功能与交互保持一致。
+ *
+ * 兼容性：如果将来在真正的 HarmonyOS 设备上跑这份 HAP，把 import 换回
+ * '@kit.UIDesignKit' 即可恢复 HDS 外观（代码里保留了原实现注释）。
+ */
+
+/** 材质类型（与 HMS hdsMaterial.MaterialType 取值一致）。 */
+export enum OpenHarmonyHdsMaterialType {
+  NONE = 0,
+  ADAPTIVE = 1,
+  IMMERSIVE = 2
+}
+
+/** 材质等级（与 HMS hdsMaterial.MaterialLevel 取值一致）。 */
+export enum OpenHarmonyHdsMaterialLevel {
+  NONE = 0,
+  ADAPTIVE = 1,
+  IMMERSIVE = 2
+}
+
+/**
+ * HMS hdsMaterial 的最小替身：材质类型/等级常量 + 能力查询。
+ * 恒定报告「本机没有任何 HDS 材质类型」，应用据此走普通 ArkUI 渲染路径。
+ */
+export class hdsMaterial {
+  static readonly MaterialType = OpenHarmonyHdsMaterialType;
+
+  static readonly MaterialLevel = OpenHarmonyHdsMaterialLevel;
+
+  /**
+   * 查询本机可渲染的材质类型。
+   * @returns 恒为空数组 —— OpenHarmony 没有 HDS。
+   */
+  static getSystemMaterialTypes(): number[] {
+    return [];
+  }
+}
