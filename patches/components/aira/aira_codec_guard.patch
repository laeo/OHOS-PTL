+import { hilog } from '@kit.PerformanceAnalysisKit';
+import { AppRuntimeContext } from '../../app/runtime/AppRuntimeContext';
+
+/**
+ * 媒体编解码守卫（HEVC 屏蔽 + 取流参数改写）。
+ *
+ * 背景：当前 x86_64 ArkWeb 引擎（社区 Chromium 114）**没有 HEVC 解码器**
+ * （ffmpeg 无 hevc decoder，M114 连 HEVC 解析器都没编），但站点（bilibili）
+ * 会同时下发 AVC(codecid 7) / HEVC(12) / AV1(13) 三条 DASH 轨，前端若选中
+ * HEVC 则视频轨全废，只剩 AAC 音轨（用户看到的"解码器是 mp4a / HEVC"，
+ * 表现为极卡、缓冲慢、只播一两帧）。
+ *
+ * 本模块提供三层能力（与系统自带浏览器 `com.ohos.browser` 的保护一致）：
+ * 1) 文档起始注入脚本（页面层，最可靠）：
+ *    - 屏蔽 HEVC：`MediaSource.isTypeSupported` / `SourceBuffer.isTypeSupported` /
+ *      `HTMLMediaElement.canPlayType` / `MediaCapabilities.decodingInfo`
+ *      对 hev1/hvc1/h265/hevc 一律返回不支持；
+ *    - 改写取流参数：`fetch` / `XMLHttpRequest.open` 对 bilibili 媒体 API
+ *      （点播 `/playurl`：fnval→16 + prefer_codec_type=1；直播 `getRoomPlayInfo`：
+ *      codec→0、format→2(fmp4)）；
+ *    - 过滤 DASH 响应：删除 HEVC/AV1 轨，强制只留 AVC。
+ * 2) `onInterceptRequest`（网络层）：同规则改写 URL 并回填响应（引擎侧发起的请求）。
+ * 3) 取流参数改写**跳过 WBI 签名请求**（带 `w_rid`）：改参数会破坏签名导致 -403。
+ *
+ * 运行期标记：脚本安装后会在 `window` 上挂 `__airaCodecGuard`（值为版本号），
+ * 同时本模块在应用启动后把版本标记写到应用沙箱
+ * `<filesDir>/media_codec_guard.json`，供 `ohos-diag` 媒体段自动判定。
+ */
+
+/** 守卫版本号（页面脚本标记 + 沙箱标记文件共用） */
+export const MEDIA_CODEC_GUARD_VERSION: string = 'aira-codec-guard-v1';
+
+/** 沙箱标记文件名（写在应用 filesDir 下） */
+export const MEDIA_CODEC_GUARD_MARKER_FILE_NAME: string = 'media_codec_guard.json';
+
+const MEDIA_CODEC_GUARD_LOG_DOMAIN: number = 0xD002000;
+const MEDIA_CODEC_GUARD_LOG_TAG: string = 'AiraCodecGuard';
+
+/** 媒体 API 主机（bilibili 系） */
+const MEDIA_HOST_KEYS: string[] = ['bilibili.com', 'bilibili.cn', 'bilivideo.com', 'bilivideo.cn', 'hdslb.com'];
+
+/** 直播取流 API 路径特征 */
+const LIVE_API_KEY: string = 'getroomplayinfo';
+
+/** 点播取流 API 路径特征 */
+const VOD_API_KEY: string = '/playurl';
+
+/** HEVC 编码标识（命中即视为 HEVC） */
+const HEVC_KEYS: string[] = ['hev1', 'hvc1', 'h265', 'hevc'];
+
+/** 原生取流超时（ms） */
+const FETCH_TIMEOUT_MS: number = 8000;
+
+/** 判断字符串是否含 HEVC 编码标识 */
+export function isHevcCodecText(text: string): boolean {
+  if (text.length === 0) {
+    return false;
+  }
+  const lower: string = text.toLowerCase();
+  for (let i = 0; i < HEVC_KEYS.length; i++) {
+    if (lower.indexOf(HEVC_KEYS[i]) >= 0) {
+      return true;
+    }
+  }
+  return false;
+}
+
+/** 判断 URL 是否属于 bilibili 媒体域 */
+export function isMediaHostUrl(url: string): boolean {
+  const lower: string = url.toLowerCase();
+  for (let i = 0; i < MEDIA_HOST_KEYS.length; i++) {
+    if (lower.indexOf(MEDIA_HOST_KEYS[i]) >= 0) {
+      return true;
+    }
+  }
+  return false;
+}
+
+/** 拆分 URL 为 base / query 段数组 / hash */
+function splitUrl(url: string): string[] {
+  const hashIdx: number = url.indexOf('#');
+  const hash: string = hashIdx >= 0 ? url.substring(hashIdx) : '';
+  const withoutHash: string = hashIdx >= 0 ? url.substring(0, hashIdx) : url;
+  const qIdx: number = withoutHash.indexOf('?');
+  if (qIdx < 0) {
+    return [withoutHash, '', hash];
+  }
+  return [withoutHash.substring(0, qIdx), withoutHash.substring(qIdx + 1), hash];
+}
+
+/** 取 query 段中的参数值，不存在返回 null */
+function getParam(parts: string[], key: string): string | null {
+  for (let i = 0; i < parts.length; i++) {
+    const item: string = parts[i];
+    const eq: number = item.indexOf('=');
+    const name: string = eq >= 0 ? item.substring(0, eq) : item;
+    if (name === key) {
+      return eq >= 0 ? item.substring(eq + 1) : '';
+    }
+  }
+  return null;
+}
+
+/** 写 query 段参数，返回是否发生变化 */
+function setParam(parts: string[], key: string, value: string): boolean {
+  let found: boolean = false;
+  let changed: boolean = false;
+  for (let i = 0; i < parts.length; i++) {
+    const item: string = parts[i];
+    const eq: number = item.indexOf('=');
+    const name: string = eq >= 0 ? item.substring(0, eq) : item;
+    if (name === key) {
+      found = true;
+      if (item !== key + '=' + value) {
+        parts[i] = key + '=' + value;
+        changed = true;
+      }
+      break;
+    }
+  }
+  if (!found) {
+    parts.push(key + '=' + value);
+    changed = true;
+  }
+  return changed;
+}
+
+/**
+ * 媒体 API 取流参数改写（ArkTS 侧，与页面脚本规则一致）。
+ *
+ * - 点播 `/playurl`：`fnval` → 16（只 DASH/AVC 轨），补 `prefer_codec_type=1`（优先 AVC）
+ * - 直播 `getRoomPlayInfo`：`codec` → 0（AVC），`format` → 2（fmp4，Chromium 无 FLV 解封装器）
+ * - 带 `w_rid`（WBI 签名）的请求**跳过**：改参数会破坏签名（服务端 -403）
+ */
+export function rewriteMediaApiUrl(url: string): string {
+  if (url.length === 0 || !isMediaHostUrl(url)) {
+    return url;
+  }
+  const lower: string = url.toLowerCase();
+  const isLive: boolean = lower.indexOf(LIVE_API_KEY) >= 0;
+  const isVod: boolean = lower.indexOf(VOD_API_KEY) >= 0;
+  if (!isLive && !isVod) {
+    return url;
+  }
+  if (lower.indexOf('w_rid=') >= 0) {
+    // WBI 签名请求：任何参数改动都会导致签名校验失败，直接放行
+    return url;
+  }
+  const segs: string[] = splitUrl(url);
+  const parts: string[] = segs[1].length > 0 ? segs[1].split('&') : [];
+  let changed: boolean = false;
+  if (isVod) {
+    const fnval: string | null = getParam(parts, 'fnval');
+    if (fnval !== null && fnval !== '16') {
+      changed = setParam(parts, 'fnval', '16') || changed;
+    }
+    if (getParam(parts, 'prefer_codec_type') === null) {
+      changed = setParam(parts, 'prefer_codec_type', '1') || changed;
+    }
+  }
+  if (isLive) {
+    const codec: string | null = getParam(parts, 'codec');
+    if (codec !== null && codec !== '0') {
+      changed = setParam(parts, 'codec', '0') || changed;
+    }
+    const format: string | null = getParam(parts, 'format');
+    if (format !== null && format !== '2') {
+      changed = setParam(parts, 'format', '2') || changed;
+    }
+  }
+  if (!changed) {
+    return url;
+  }
+  return segs[0] + '?' + parts.join('&') + segs[2];
+}
+
+/** 是否为需要关注的媒体取流请求 */
+export function isMediaApiUrl(url: string): boolean {
+  if (!isMediaHostUrl(url)) {
+    return false;
+  }
+  const lower: string = url.toLowerCase();
+  return lower.indexOf(LIVE_API_KEY) >= 0 || lower.indexOf(VOD_API_KEY) >= 0;
+}
