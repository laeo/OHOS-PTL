+}
+
+/** 原生取流结果 */
+interface MediaFetchResult {
+  code: number
+  body: string
+  mime: string
+  header: Header[]
+}
+
+/** 用原生 http 拉取改写后的媒体 API */
+async function fetchMediaApi(url: string, request: WebResourceRequest): Promise<MediaFetchResult> {
+  const header: Record<string, string> = {};
+  try {
+    const reqHeaders: Header[] = request.getRequestHeader();
+    for (const item of reqHeaders) {
+      const key: string = item.headerKey.toLowerCase();
+      if (key === 'host' || key === 'connection' || key === 'content-length' ||
+        key === 'accept-encoding' || key === 'origin' || key === 'referer') {
+        continue;
+      }
+      header[item.headerKey] = item.headerValue;
+    }
+  } catch (error) {
+    hilog.warn(MEDIA_CODEC_GUARD_LOG_DOMAIN, MEDIA_CODEC_GUARD_LOG_TAG,
+      'read request header failed: %{public}s', `${error}`);
+  }
+  header['Accept-Encoding'] = 'identity';
+  const httpRequest = http.createHttp();
+  try {
+    const res = await httpRequest.request(url, {
+      method: http.RequestMethod.GET,
+      header: header,
+      readTimeout: FETCH_TIMEOUT_MS,
+      connectTimeout: FETCH_TIMEOUT_MS,
+      expectDataType: http.HttpDataType.STRING
+    });
+    const respHeader: Header[] = [];
+    let mime: string = 'application/json';
+    const rawHeader: Record<string, string> = res.header as Record<string, string>;
+    const keys: string[] = Object.keys(rawHeader);
+    for (const key of keys) {
+      const lower: string = key.toLowerCase();
+      if (lower === 'content-encoding' || lower === 'content-length' || lower === 'transfer-encoding') {
+        continue;
+      }
+      if (lower === 'content-type') {
+        mime = rawHeader[key];
+      }
+      respHeader.push({ headerKey: key, headerValue: rawHeader[key] });
+    }
+    const body: string = typeof res.result === 'string' ? res.result : JSON.stringify(res.result);
+    return { code: res.responseCode, body: body, mime: mime, header: respHeader };
+  } finally {
+    try {
+      httpRequest.destroy();
+    } catch (error) {
+      // 忽略销毁异常
+    }
+  }
+}
+
+/**
+ * `onInterceptRequest` 回调：网络层改写媒体取流参数。
+ *
+ * 说明：ArkWeb 的 `onInterceptRequest` **不能直接改写请求 URL**（回调只给只读的
+ * `WebResourceRequest`），因此这里对需要改写的请求改用原生 http 拉取改写后的 URL
+ * 并把响应回填给 WebView。页面层脚本已先行改写的请求不会走到这条路径
+ * （此时 URL 已是目标形态，直接放行，由 WebView 正常加载，保留 Cookie 等上下文）。
+ */
+export function handleMediaCodecGuardInterceptRequest(event: OnInterceptRequestEvent): WebResourceResponse | null {
+  const request: WebResourceRequest = event?.request;
+  if (!request) {
+    return null;
+  }
+  let url: string = '';
+  try {
+    url = request.getRequestUrl();
+  } catch (error) {
+    return null;
+  }
+  if (!isMediaApiUrl(url)) {
+    return null;
+  }
+  const rewritten: string = rewriteMediaApiUrl(url);
+  if (rewritten === url) {
+    hilog.info(MEDIA_CODEC_GUARD_LOG_DOMAIN, MEDIA_CODEC_GUARD_LOG_TAG,
+      'intercept pass url=%{public}s', url.slice(0, 140));
+    return null;
+  }
+  hilog.info(MEDIA_CODEC_GUARD_LOG_DOMAIN, MEDIA_CODEC_GUARD_LOG_TAG,
+    'intercept rewrite url=%{public}s -> %{public}s', url.slice(0, 140), rewritten.slice(0, 140));
+  const response: WebResourceResponse = new WebResourceResponse();
+  response.setResponseIsReady(false);
+  response.setResponseCode(200);
+  response.setReasonMessage('OK');
+  response.setResponseEncoding('utf-8');
+  response.setResponseMimeType('application/json');
+  fetchMediaApi(rewritten, request).then((result: MediaFetchResult) => {
+    response.setResponseCode(result.code);
+    response.setResponseMimeType(result.mime);
+    response.setResponseData(result.body);
+    if (result.header.length > 0) {
+      response.setResponseHeader(result.header);
+    }
+    response.setResponseIsReady(true);
+    hilog.info(MEDIA_CODEC_GUARD_LOG_DOMAIN, MEDIA_CODEC_GUARD_LOG_TAG,
+      'intercept filled code=%{public}d bytes=%{public}d', result.code, result.body.length);
+  }).catch((error: Error) => {
+    hilog.error(MEDIA_CODEC_GUARD_LOG_DOMAIN, MEDIA_CODEC_GUARD_LOG_TAG,
+      'intercept fetch failed: %{public}s', error?.message ?? 'unknown');
+    response.setResponseCode(502);
+    response.setResponseData('{"code":-1,"message":"codec guard fetch failed"}');
+    response.setResponseIsReady(true);
+  });
+  return response;
+}
+
+/**
+ * 媒体编解码守卫服务。
+ *
+ * - 页面层：把守卫脚本挂进每个 Web 组件的 `runJavaScriptOnDocumentStart`。
+ * - 网络层：`onInterceptRequest` 里对媒体取流 API 做参数改写兜底。
+ */
+export class WebMediaCodecGuardScriptService {
+  buildDocumentStartScriptItem(): ScriptItem {
+    const script: string = buildMediaCodecGuardScript();
+    if (script.indexOf(MEDIA_CODEC_GUARD_VERSION) < 0) {
+      // 脚本里的版本号是字面量（为了能在 HAP 的 abc 里被静态检出），
+      // 这里做一次运行期自检，防止两边漂移。
+      hilog.error(MEDIA_CODEC_GUARD_LOG_DOMAIN, MEDIA_CODEC_GUARD_LOG_TAG,
+        'guard version mismatch: script does not carry %{public}s', MEDIA_CODEC_GUARD_VERSION);
+    }
+    return {
+      script: script,
+      scriptRules: ['*']
+    };
+  }
+}
+
+let runtimeMarkerWritten: boolean = false;
+
+/**
+ * 运行期标记：守卫脚本真正被挂到某个 Web 组件上时，在应用沙箱里写一份标记文件。
+ *
+ * 目的：让 `ohos-diag` 的媒体段能自动判定"这台机器上的 Aira 是否带 HEVC 屏蔽保护"，
+ * 而不用去解 HAP 里的 abc。文件内容是版本号 + 时间戳。
+ */
+export function markMediaCodecGuardApplied(): void {
+  if (runtimeMarkerWritten) {
+    return;
+  }
+  try {
+    const context = AppRuntimeContext.getApplicationContext();
+    const path = `${context.filesDir}/${MEDIA_CODEC_GUARD_MARKER_FILE_NAME}`;
+    const payload = JSON.stringify({
+      guard: MEDIA_CODEC_GUARD_VERSION,
+      appliedAt: Date.now()
+    });
+    const file = fileIo.openSync(
+      path,
+      fileIo.OpenMode.WRITE_ONLY | fileIo.OpenMode.CREATE | fileIo.OpenMode.TRUNC
+    );
+    try {
+      const bytes = new Uint8Array(bufferFromString(payload));
+      fileIo.writeSync(file.fd, bytes.buffer);
+      fileIo.fsyncSync(file.fd);
+    } finally {
+      fileIo.closeSync(file);
+    }
+    hilog.info(MEDIA_CODEC_GUARD_LOG_DOMAIN, MEDIA_CODEC_GUARD_LOG_TAG,
+      'runtime marker written path=%{public}s version=%{public}s', path, MEDIA_CODEC_GUARD_VERSION);
+    runtimeMarkerWritten = true;
+  } catch (error) {
+    hilog.warn(MEDIA_CODEC_GUARD_LOG_DOMAIN, MEDIA_CODEC_GUARD_LOG_TAG,
+      'runtime marker write failed: %{public}s', `${error}`);
+  }
+}
+
+/** UTF-8 字符串 -> ArrayBuffer */
+function bufferFromString(text: string): ArrayBuffer {
+  const bytes = new ArrayBuffer(text.length);
+  const view = new Uint8Array(bytes);
+  for (let i = 0; i < text.length; i++) {
+    view[i] = text.charCodeAt(i) & 0xFF;
+  }
+  return bytes;
+}
