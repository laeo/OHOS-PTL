+   *
+   * 判据与 PageDesktopViewModel.filterItemExceedCurrentScreen() 一致：
+   *   area 合法(长度 2 且是有限数) 且 row/column 落在当前宫格范围内。
+   * area 缺失/NaN 的元素在 DesktopItem 里算出的图标中心坐标是 NaN，ArkUI 无法摆放，
+   * 因此不会出现在屏幕上（真机现象：桌面一个图标都没有，但应用中心/dock 正常）。
+   */
+  private logDesktopIconCount(reason: string): void {
+    try {
+      const items: GridLayoutItemInfo[] = LaunchLayoutCacheManager.getInstance()
+        .selectAppAndShortcutByContainer(CommonConstants.CONTAINER_DESKTOP, false);
+      let rows: number = 0;
+      let columns: number = 0;
+      try {
+        const rst: CalculateDesktopRst = LayoutViewModel.getInstance().calculateDesktop();
+        rows = rst.mRows ?? 0;
+        columns = rst.mColumns ?? 0;
+      } catch (err) {
+        log.showWarn(TAG, `logDesktopIconCount calculateDesktop err: ${err?.code}`);
+      }
+      let withArea: number = 0;
+      let visible: number = 0;
+      for (const item of items) {
+        if (!item) {
+          continue;
+        }
+        const area: number[] | undefined = item.area;
+        const areaOk: boolean = !!area && area.length === 2 &&
+          Number.isFinite(area[0]) && Number.isFinite(area[1]);
+        if (areaOk) {
+          withArea++;
+        }
+        if (!areaOk || rows <= 0 || columns <= 0) {
+          continue;
+        }
+        const row: number = item.row ?? -1;
+        const column: number = item.column ?? -1;
+        const rowInGrid: boolean = row >= 0 && ((row + area![1] - 1) < rows);
+        const colInGrid: boolean = column >= 0 && ((column + area![0] - 1) < columns);
+        if (rowInGrid && colInGrid) {
+          visible++;
+        }
+      }
