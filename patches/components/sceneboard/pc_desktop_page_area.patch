+        if (v !== undefined) {
+          areaFixed = v;
+        }
+      } catch (err) {
+        log.showWarn(TAG, `logDesktopIconCount AppStorage err: ${err?.code}`);
+      }
+      log.showWarn(TAG,
+        'DESKTOPICONS page=-1 layoutVisible=%{public}d reason=%{public}s desktopIcons=%{public}d total=%{public}d ' +
+        'withArea=%{public}d grid=%{public}dx%{public}d areaFixed=%{public}d',
+        visible, reason, visible, items.length, withArea, rows, columns, areaFixed);
+    } catch (err) {
+      log.showError(TAG, `logDesktopIconCount err: ${err?.code} ${err?.message}`);
+    }
+  }
