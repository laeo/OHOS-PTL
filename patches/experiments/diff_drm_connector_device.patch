+int32_t DrmConnector::EnsureBacklightResolved()
+{
+    if (mBacklightResolved) {
+        return (mBacklightFd >= 0) ? DISPLAY_SUCCESS : DISPLAY_FAILURE;
+    }
+    mBacklightResolved = true;
+    if (FindBacklightNode(mBacklightPath, mBacklightMax) != DISPLAY_SUCCESS) {
+        DISPLAY_LOGW("no controllable backlight found (e.g. QEMU), brightness control disabled");
+        return DISPLAY_FAILURE;
+    }
+    mBacklightFd = open(mBacklightPath.c_str(), O_RDWR | O_CLOEXEC);
+    if (mBacklightFd < 0) {
+        DISPLAY_LOGE("open backlight %{public}s failed %{public}s", mBacklightPath.c_str(), strerror(errno));
+        return DISPLAY_FAILURE;
+    }
+    return DISPLAY_SUCCESS;
+}
