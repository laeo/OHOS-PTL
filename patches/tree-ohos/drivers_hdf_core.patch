+/*
+ * fix_order: the boot order now starts hdf_devmgr from the init job, before any start-mode:boot
+ * host (composer_host), so a host should normally attach on the first try. Keep only a SHORT,
+ * bounded retry as a safety net for the small window between hdf_devmgr being forked and its
+ * SA5100 devsvc manager becoming reachable. This matches the retry already present inside
+ * DevmgrServiceProxyAttachDeviceHost() (100 x 20ms in devmgr_service_proxy.c), so the whole
+ * attach path tolerates the same order of magnitude of devmgr startup latency. No long
+ * (tens-of-seconds) backoff: that only masked the boot-order bug.
+ */
+#define DEVHOST_ATTACH_MAX_TRY      100
+#define DEVHOST_ATTACH_RETRY_US     20000
 
