         return HDF_FAILURE;
     }
 
-    int ret = DevmgrServiceClntAttachDeviceHost(hostService->hostId, service);
+    /* fix_race: never give up after a single attach failure; stay alive and retry (see top of file). */
+    int ret = HDF_FAILURE;
+    const char *name = (hostService->hostName != NULL) ? hostService->hostName : "(null)";
+    for (int i = 0; i < DEVHOST_ATTACH_MAX_TRY; i++) {
+        ret = DevmgrServiceClntAttachDeviceHost(hostService->hostId, service);
+        if (ret == HDF_SUCCESS) {
+            if (i > 0) {
+                HdfDiagPrint("ATTACH", "host %s attached to devmgr after %d retry(ies)", name, i);
+            }
+            break;
+        }
+        HDF_LOGE("failed to start host service, attach host error %{public}d (try %{public}d/%{public}d), retry",
+            ret, i + 1, DEVHOST_ATTACH_MAX_TRY);
+        HdfDiagPrint("ATTACH", "AttachDeviceHost FAIL ret=%d host=%s try=%d/%d, retry",
+            ret, name, i + 1, DEVHOST_ATTACH_MAX_TRY);
+        (void)usleep(DEVHOST_ATTACH_RETRY_US);
+    }
     if (ret != HDF_SUCCESS) {
-        HDF_LOGE("failed to start host service, attach host error %{public}d", ret);
+        HDF_LOGE("failed to start host service, attach host error %{public}d after %{public}d tries",
+            ret, DEVHOST_ATTACH_MAX_TRY);
+        HdfDiagPrint("ATTACH", "AttachDeviceHost exhausted retries ret=%d host=%s", ret, name);
         return ret;
     }
 
