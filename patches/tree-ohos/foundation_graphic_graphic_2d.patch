+void RSMainThread::NotifyBackdropFilterNodeAppeared(uint64_t nodeId)
+{
+    // Workaround: under virgl the first frame(s) that draw a newly appeared backdrop-filter
+    // (blur) node may composite incompletely (only part of the blurred panel ends up in the
+    // display buffer). A single forced full-frame refresh right after such a node first shows
+    // up makes the result correct without any user input (a mouse move would do the same).
+    // Bounded by count/interval so it cannot turn into a per-frame full redraw.
+    constexpr int32_t MAX_FORCE_REFRESH_COUNT = 12;
+    constexpr int64_t MIN_FORCE_REFRESH_INTERVAL_MS = 1000;
+    constexpr int64_t MAX_BOOT_WINDOW_MS = 600000; // only work around the post-boot race
+    if (backdropFilterForceRefreshCount_ >= MAX_FORCE_REFRESH_COUNT) {
+        return;
+    }
+    int64_t now = GetCurrentSystimeMs();
+    if (firstBackdropFilterTimeMs_ == 0) {
+        firstBackdropFilterTimeMs_ = now;
+    }
+    if (now - firstBackdropFilterTimeMs_ > MAX_BOOT_WINDOW_MS) {
+        return;
+    }
+    // Check the interval before marking the node as seen: a node that arrives during the
+    // cooldown must stay eligible, otherwise it would be dropped without ever forcing.
+    if (now - lastBackdropFilterForceTimeMs_ < MIN_FORCE_REFRESH_INTERVAL_MS) {
+        return;
+    }
+    if (!backdropFilterNodesSeen_.insert(nodeId).second) {
+        return;
+    }
+    lastBackdropFilterForceTimeMs_ = now;
+    ++backdropFilterForceRefreshCount_;
+    RS_LOGI("RSFILTDBG NotifyBackdropFilterNodeAppeared: force full refresh for new backdrop filter node %{public}"
+        PRIu64 " (count:%{public}d)", nodeId, backdropFilterForceRefreshCount_);
+    SetDirtyFlag();
+    ForceRefreshForUni();
+}
