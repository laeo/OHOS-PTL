+constexpr const char *BACKLIGHT_CLASS_DIR = "/sys/class/backlight";
+// [diag] Persistent parameter that selects a lower panel resolution, e.g.
+// "1920x1200".  Empty / unset = use the panel's preferred mode.
+constexpr const char *RESOLUTION_OVERRIDE_PARAM = "persist.display.resolution";
+// Native Intel backlight node; preferred over the generic acpi_video one.
+constexpr const char *PREFERRED_BACKLIGHT = "intel_backlight";
+// OHOS passes brightness as a 0..255 level (BRIGHTNESS_MAX in the
+// display_power_manager brightness service); the sysfs node has its own range.
+constexpr uint32_t OHOS_BRIGHTNESS_MAX = 255;
+
+uint32_t ReadUintFromFile(const std::string &path)
+{
+    FILE *fp = fopen(path.c_str(), "r");
+    if (fp == nullptr) {
+        return 0;
+    }
+    char buf[32] = {0};
+    char *ret = fgets(buf, sizeof(buf), fp);
+    fclose(fp);
+    if (ret == nullptr) {
+        return 0;
+    }
+    return static_cast<uint32_t>(strtoul(buf, nullptr, 10));
+}
+
+// Pick a backlight node and read its max_brightness.  Returns DISPLAY_SUCCESS
+// and fills |brightnessPath|/|maxLevel| on success.
+int32_t FindBacklightNode(std::string &brightnessPath, uint32_t &maxLevel)
+{
+    DIR *dir = opendir(BACKLIGHT_CLASS_DIR);
+    if (dir == nullptr) {
+        return DISPLAY_FAILURE;
+    }
+    std::vector<std::string> names;
+    struct dirent *entry = nullptr;
+    while ((entry = readdir(dir)) != nullptr) {
+        if ((strcmp(entry->d_name, ".") == 0) || (strcmp(entry->d_name, "..") == 0)) {
+            continue;
+        }
+        names.emplace_back(entry->d_name);
+    }
+    closedir(dir);
+
+    std::string chosen;
+    for (const auto &name : names) {
+        if (name == PREFERRED_BACKLIGHT) {
+            chosen = name;
+            break;
+        }
+    }
+    if (chosen.empty()) {
+        // Prefer a native node over the generic ACPI one.
+        for (const auto &name : names) {
+            if (name.rfind("acpi_video", 0) != 0) {
+                chosen = name;
+                break;
+            }
+        }
+    }
+    if (chosen.empty() && !names.empty()) {
+        chosen = names.front();
+    }
+    if (chosen.empty()) {
+        return DISPLAY_FAILURE;
+    }
+
+    std::string base = std::string(BACKLIGHT_CLASS_DIR) + "/" + chosen;
+    uint32_t max = ReadUintFromFile(base + "/max_brightness");
+    if (max == 0) {
+        DISPLAY_LOGW("backlight %{public}s has no usable max_brightness", chosen.c_str());
+        return DISPLAY_FAILURE;
+    }
+    maxLevel = max;
+    brightnessPath = base + "/brightness";
+    DISPLAY_LOGI("found backlight node %{public}s (max %{public}u)", chosen.c_str(), max);
+    return DISPLAY_SUCCESS;
+}
