+// [diag] Optional resolution downgrade.
+//
+// The panel of this product is 3072x1920.  Every frame the display pipeline
+// creates and destroys a framebuffer of that size (23.6 MB), which is the
+// single most expensive per-frame operation.  When the UI still feels
+// sluggish, running the panel at a lower resolution (1/2.6 of the pixels)
+// removes most of that cost.
+//
+// The override is off by default.  It is enabled by writing the wanted
+// resolution as "<width>x<height>" into the persistent parameter
+// "persist.display.resolution", e.g.
+//
+//     param set persist.display.resolution 1920x1200
+//
+// and it only applies to a mode the panel actually advertises.
+void DrmConnector::ApplyResolutionOverride()
+{
+    std::string value = system::GetParameter(RESOLUTION_OVERRIDE_PARAM, "");
+    if (value.empty()) {
+        return;
+    }
+    uint32_t wantWidth = 0;
+    uint32_t wantHeight = 0;
+    if (sscanf(value.c_str(), "%ux%u", &wantWidth, &wantHeight) != 2 || wantWidth == 0 || wantHeight == 0) {
+        DISPLAY_LOGW("invalid %{public}s value '%{public}s', ignored", RESOLUTION_OVERRIDE_PARAM, value.c_str());
+        return;
+    }
+    for (auto &entry : mModes) {
+        drmModeModeInfoPtr info = entry.second.GetModeInfoPtr();
+        if (info != nullptr && info->hdisplay == wantWidth && info->vdisplay == wantHeight) {
+            mPreferenceId = entry.first;
+            DISPLAY_LOGI("resolution override %{public}s -> mode id %{public}d (%{public}ux%{public}u)",
+                value.c_str(), entry.first, wantWidth, wantHeight);
+            return;
+        }
+    }
+    DISPLAY_LOGW("resolution override %{public}s (%{public}ux%{public}u) not offered by the panel, ignored",
+        value.c_str(), wantWidth, wantHeight);
 }
 
