+uint32_t DrmDevice::ConvertToDrmFormatExact(PixelFormat fmtIn)
+{
+    // DRM fourcc names describe the register value bit order, so on little-endian
+    // the in-memory byte order is reversed: XRGB8888 -> B,G,R,X in memory.
+    // OHOS PixelFormat names describe the in-memory byte order instead.
+    // Only the unambiguous 32bpp formats are mapped here; everything else returns
+    // 0 and the caller falls back to the legacy ConvertToDrmFormat() table.
+    static const PixelFormatConvertTbl exactTable[] = {
+        {DRM_FORMAT_ABGR8888, PIXEL_FMT_RGBA_8888}, // memory R,G,B,A
+        {DRM_FORMAT_ARGB8888, PIXEL_FMT_BGRA_8888}, // memory B,G,R,A
+        {DRM_FORMAT_XBGR8888, PIXEL_FMT_RGBX_8888}, // memory R,G,B,X
+        {DRM_FORMAT_XRGB8888, PIXEL_FMT_BGRX_8888}, // memory B,G,R,X
+    };
+    uint32_t fmtOut = 0;
+    for (uint32_t i = 0; i < sizeof(exactTable) / sizeof(exactTable[0]); i++) {
+        if (exactTable[i].pixFormat == fmtIn) {
+            fmtOut = exactTable[i].drmFormat;
+            break;
+        }
+    }
+    DISPLAY_LOGD("exact fmtIn %{public}d, outFmt %{public}d", fmtIn, fmtOut);
+    return fmtOut;
+}
