+// DRM keeps a connector_status of "unknown" for an attached panel (eDP) until
+// userspace performs a probe.  drmModeGetConnector() (= _drmModeGetConnector
+// with probe=1) issues DRM_IOCTL_MODE_GETCONNECTOR with count_modes==0, which,
+// when the caller is DRM master, makes the kernel run connector->funcs->
+// fill_modes() - a full HPD/EDID probe.  We retry that (eDP detection can
+// still be pending while xe finishes powering the panel) until the state is
+// resolved or the timeout expires.  A definite disconnected wins immediately.
+int32_t DrmConnector::RefreshConnection(int timeoutMs)
+{
+    if (mConnectState != DRM_MODE_UNKNOWNCONNECTION) {
+        return DISPLAY_SUCCESS;
+    }
+    if (mDrmFdPtr == nullptr) {
+        comp_kmsg::Print("DRM", "Connector probe: id=%u mDrmFdPtr is null, skip", mId);
+        return DISPLAY_FAILURE;
+    }
+    int drmFd = mDrmFdPtr->GetFd();
+    if (drmFd < 0) {
+        comp_kmsg::Print("DRM", "Connector probe: id=%u drm fd invalid", mId);
+        return DISPLAY_FAILURE;
+    }
+
+    struct timespec start;
+    clock_gettime(CLOCK_MONOTONIC, &start);
+    int attempts = 0;
+    for (;;) {
+        attempts++;
+        drmModeConnectorPtr c = drmModeGetConnector(drmFd, mId);
+        if (c != nullptr) {
+            drmModeConnection state = c->connection;
+            int modeCount = c->count_modes;
+            if (state != DRM_MODE_UNKNOWNCONNECTION) {
+                mConnectState = state;
+                InitModes(*c);
+                comp_kmsg::Print("DRM",
+                    "Connector probe: id=%u type=%u typeId=%u resolved state=%d after %d attempt(s) "
+                    "modes=%zu prefId=%d internal=%d",
+                    mId, mDrmType, mDrmTypeId, static_cast<int>(state), attempts,
+                    mModes.size(), mPreferenceId, IsInternalPanel() ? 1 : 0);
+                drmModeFreeConnector(c);
+                return DISPLAY_SUCCESS;
+            }
+            comp_kmsg::Print("DRM",
+                "Connector probe: id=%u type=%u typeId=%u attempt %d still UNKNOWN (modes=%d)",
+                mId, mDrmType, mDrmTypeId, attempts, modeCount);
+            drmModeFreeConnector(c);
+        } else {
+            comp_kmsg::Print("DRM", "Connector probe: id=%u attempt %d drmModeGetConnector null errno=%d(%s)",
+                mId, attempts, errno, strerror(errno));
+        }
+
+        struct timespec now;
+        clock_gettime(CLOCK_MONOTONIC, &now);
+        long elapsedMs = (now.tv_sec - start.tv_sec) * 1000L + (now.tv_nsec - start.tv_nsec) / 1000000L;
+        if (elapsedMs >= timeoutMs) {
+            comp_kmsg::Print("DRM",
