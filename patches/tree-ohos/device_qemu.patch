+# instead of this board script, which is pinned to the 6.6 layout.
+if (linux_kernel_version == "linux-6.6") {
+  kernel_build_script_dir = "//device/qemu/common/virt_full/kernel"
+  kernel_source_dir = "//kernel/linux/$linux_kernel_version"
+  kernel_modules_dir = "$root_build_dir/kernel_modules"
+
+  kernel_image = ""
+  if (target_cpu == "arm") {
+    kernel_image = "zImage"
+  } else if (target_cpu == "arm64") {
+    kernel_image = "Image"
+  } else if (target_cpu == "riscv64") {
