+    if (country == nullptr || strlen(country) < 2) {
+        country = DEFAULT_WIFI_COUNTRY_CODE;
+    }
+
+    for (unsigned int i = 0; i < sizeof(delays) / sizeof(delays[0]); i++) {
+        if (delays[i] > 0) {
+            usleep((useconds_t)delays[i] * 1000);
+        }
+        if (WifiApplyRegDomain(handle, country)) {
+            HDF_LOGI("%{public}s}: regulatory domain %{public}s applied", __FUNCTION__, country);
+            return nullptr;
+        }
+    }
+    HDF_LOGE("%{public}s}: could not apply the regulatory domain, "
+        "the kernel keeps the built-in world domain", __FUNCTION__);
+    return nullptr;
+}
