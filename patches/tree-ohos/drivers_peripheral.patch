+/*
+ * bring-up 退出自证（fix_svcreg）：
+ *   composer_host 会反复退出，但没有 CRASH（说明不是信号崩溃）。这里用
+ *   atexit / destructor / signal handler 三类出口把 "谁让它退出、退出码/信号"
+ *   写进 /dev/kmsg 与 /data/compkmsg/compkmsg.<proc>.log（COMPKMSG:EXIT 前缀）。
+ *   全部使用 async-signal-safe 的 open/write/close，绝不在 handler 里锁/分配。
+ */
+static int g_devHostExitLogged = 0;
+
+static void DevHostItoa(int value, char *out, int outLen)
+{
+    if (out == NULL || outLen <= 1) {
+        return;
+    }
+    unsigned int u = (unsigned int)value;
+    int neg = 0;
+    if (value < 0) {
+        neg = 1;
+        u = (unsigned int)(-value);
+    }
+    char tmp[16];
+    int n = 0;
+    if (u == 0) {
+        tmp[n++] = '0';
+    }
+    while (u > 0 && n < 15) {
+        tmp[n++] = (char)('0' + (u % 10));
+        u /= 10;
+    }
+    int k = 0;
+    if (neg && k < outLen - 1) {
+        out[k++] = '-';
+    }
+    while (n > 0 && k < outLen - 1) {
+        out[k++] = tmp[--n];
+    }
+    out[k] = '\0';
+}
+
+static void DevHostWriteRaw(const char *reason, int value)
+{
+    char num[16] = {0};
+    DevHostItoa(value, num, sizeof(num));
+    char msg[128] = {0};
+    int p = 0;
+    const char *r = reason;
+    while (r != NULL && *r != '\0' && p < (int)sizeof(msg) - 16) {
+        msg[p++] = *r++;
+    }
+    const char *eq = "=";
+    while (*eq != '\0' && p < (int)sizeof(msg) - 16) {
+        msg[p++] = *eq++;
+    }
+    int q = 0;
+    while (num[q] != '\0' && p < (int)sizeof(msg) - 2) {
+        msg[p++] = num[q++];
+    }
+    msg[p] = '\0';
+
+    int kfd = open("/dev/kmsg", O_WRONLY | O_CLOEXEC);
+    if (kfd >= 0) {
+        (void)write(kfd, "<3>COMPKMSG:EXIT ", 17);
+        (void)write(kfd, msg, strlen(msg));
+        (void)write(kfd, "\n", 1);
+        close(kfd);
+    }
+
+    char comm[32] = {0};
+    int cfd = open("/proc/self/comm", O_RDONLY | O_CLOEXEC);
+    if (cfd >= 0) {
+        ssize_t n = read(cfd, comm, sizeof(comm) - 1);
+        close(cfd);
+        if (n > 0) {
+            comm[n] = '\0';
+            char *nl = strchr(comm, '\n');
+            if (nl != NULL) {
+                *nl = '\0';
+            }
+        }
+    }
+    if (comm[0] == '\0') {
+        (void)strncpy(comm, "unknown", sizeof(comm) - 1);
+    }
+    char path[160] = {0};
+    const char *d = "/data/compkmsg/compkmsg.";
+    int off = 0;
+    while (*d != '\0' && off < (int)sizeof(path) - 8) {
+        path[off++] = *d++;
+    }
+    int i = 0;
+    while (comm[i] != '\0' && off < (int)sizeof(path) - 8) {
+        path[off++] = comm[i++];
+    }
+    const char *suffix = ".log";
+    i = 0;
+    while (suffix[i] != '\0' && off < (int)sizeof(path) - 1) {
+        path[off++] = suffix[i++];
+    }
+    path[off] = '\0';
+    int ffd = open(path, O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0666);
+    if (ffd >= 0) {
+        (void)write(ffd, "COMPKMSG:EXIT ", 14);
+        (void)write(ffd, msg, strlen(msg));
+        (void)write(ffd, "\n", 1);
+        close(ffd);
+    }
+}
+
+static void DevHostExitAtexit(void)
+{
+    if (g_devHostExitLogged == 0) {
+        g_devHostExitLogged = 1;
+        DevHostWriteRaw("atexit_normal_return", 0);
+    }
+}
+
+static void __attribute__((unused)) DevHostExitDestructor(void)
+{
+    if (g_devHostExitLogged == 0) {
+        g_devHostExitLogged = 1;
+        DevHostWriteRaw("destructor_process_teardown", 0);
+    }
+}
+
+static void DevHostExitSignalHandler(int sig)
+{
+    g_devHostExitLogged = 1;
+    DevHostWriteRaw("fatal_signal", sig);
+    (void)signal(sig, SIG_DFL);
+    (void)raise(sig);
+}
+
+static void DevHostInstallExitDiag(void)
+{
+    (void)atexit(DevHostExitAtexit);
+    (void)signal(SIGTERM, DevHostExitSignalHandler);
+    (void)signal(SIGINT, DevHostExitSignalHandler);
+    (void)signal(SIGHUP, DevHostExitSignalHandler);
+    (void)signal(SIGQUIT, DevHostExitSignalHandler);
+    (void)signal(SIGABRT, DevHostExitSignalHandler);
+    (void)signal(SIGSEGV, DevHostExitSignalHandler);
+    (void)signal(SIGBUS, DevHostExitSignalHandler);
+    (void)signal(SIGILL, DevHostExitSignalHandler);
+    (void)signal(SIGFPE, DevHostExitSignalHandler);
+}
