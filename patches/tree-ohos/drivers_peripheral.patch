+/* [generic nl80211 port] The link tuning is retried in the background: the
+ * chip HAL is initialised by hdf_devhost, which can run before the system
+ * partition (and with it the regulatory database) is available. */
+static void *WifiLinkTuningThread(void *arg)
+{
+    wifiHandle handle = (wifiHandle)arg;
+    const char *country = getenv("OHOS_WIFI_COUNTRY_CODE");
+    /* retry delays in ms */
+    static const int delays[] = {0, 3000, 10000, 30000, 60000};
