+ * Returns true when the country was accepted by the kernel. */
+static bool WifiApplyRegDomain(wifiHandle handle, const char *country)
+{
+    if (WifiReloadRegDb(handle) != HAL_SUCCESS) {
+        HDF_LOGW("%{public}s}: regulatory.db not available yet", __FUNCTION__);
+    }
+    if (WifiSetRegDomain(handle, country) != HAL_SUCCESS) {
+        HDF_LOGW("%{public}s}: country %{public}s not accepted yet", __FUNCTION__, country);
+        return false;
+    }
+    return true;
