+/* [generic nl80211 port] Ask the wireless core to apply a regulatory domain.
+ *
+ * The vendor command above (WIFI_SUBCMD_SET_COUNTRY_CODE) is only understood
+ * by the hdfwifi kernel driver.  With a stock mac80211 driver (iwlwifi on
+ * Intel PTL, ath, rtl, mac80211_hwsim, ...) it is silently dropped, so the
+ * kernel keeps the built-in "world" regulatory domain.  The world domain is
+ * the most conservative one: on 5 GHz it only allows 20 MHz channels, marks
+ * 52..144 as DFS (radar CAC of 60 s before the link comes up) and limits the
+ * transmit power.  That directly caps the achievable PHY rate / throughput.
+ *
+ * NL80211_CMD_REQ_SET_REG is the generic ("iw reg set XX") request: it only
+ * carries the ISO-3166 alpha-2 code and lets cfg80211 look the domain up in
+ * the regulatory database (needs CONFIG_CFG80211_CRDA_SUPPORT and
+ * regulatory.db).  It applies to every wiphy, so no interface index is
+ * needed. */
+class SetRegDomainCommand : public WifiCommand {
+public:
+    SetRegDomainCommand(wifiHandle handle, const char *countryCode)
+        : WifiCommand("SetRegDomainCommand", handle, 0)
+    {
+        mCountryCode = countryCode;
+    }
+    int Create() override
+    {
+        int ret = mMsg.Create(NL80211_CMD_REQ_SET_REG);
+        if (ret < 0) {
+            HDF_LOGE("Can't create reg domain message - %{public}d", ret);
+            return ret;
+        }
+        ret = mMsg.PutString(NL80211_ATTR_REG_ALPHA2, mCountryCode);
+        if (ret < 0) {
+            HDF_LOGE("Can't put reg alpha2 - %{public}d", ret);
+            return ret;
+        }
+        return HAL_SUCCESS;
+    }
+private:
+    const char *mCountryCode;
+};
+
+/* Reload the regulatory database from the firmware directory.  The kernel
+ * loads /lib/firmware/regulatory.db (firmware_class.path=/system/lib/firmware
+ * on this product) when the request is made.  The automatic load at
+ * late_initcall happens before /system is mounted, so the db has to be
+ * reloaded explicitly from user space once the system is up. */
+class ReloadRegDbCommand : public WifiCommand {
+public:
+    ReloadRegDbCommand(wifiHandle handle)
+        : WifiCommand("ReloadRegDbCommand", handle, 0)
+    {
+    }
+    int Create() override
+    {
+        int ret = mMsg.Create(NL80211_CMD_RELOAD_REGDB);
+        if (ret < 0) {
+            HDF_LOGE("Can't create reload regdb message - %{public}d", ret);
+            return ret;
+        }
+        return HAL_SUCCESS;
+    }
+};
+
+/* [generic nl80211 port] Turn off the driver's power save for the STA
+ * interface.  iwlwifi defaults to power_save=1 ("balanced"), which enables
+ * packet coalescing / long listen intervals; that adds tens of milliseconds
+ * of latency and noticeably lowers the throughput of small, latency sensitive
+ * transfers (e.g. "apk add", which opens a new connection per file). */
+class SetPowerSaveCommand : public WifiCommand {
+public:
+    SetPowerSaveCommand(wifiInterfaceHandle handle)
+        : WifiCommand("SetPowerSaveCommand", handle, 0)
+    {
+    }
+    int Create() override
+    {
+        int ret = mMsg.Create(NL80211_CMD_SET_POWER_SAVE);
+        if (ret < 0) {
+            HDF_LOGE("Can't create power save message - %{public}d", ret);
+            return ret;
+        }
+        ret = mMsg.PutU32(NL80211_ATTR_PS_STATE, NL80211_PS_DISABLED);
+        if (ret < 0) {
+            HDF_LOGE("Can't put ps state - %{public}d", ret);
+            return ret;
+        }
+        return HAL_SUCCESS;
+    }
+};
+
+static WifiError WifiSetRegDomain(wifiHandle handle, const char *country_code)
+{
+    if (!handle || !country_code || strlen(country_code) < 2) {
+        HDF_LOGE("%{public}s: invalid handle or country code", __FUNCTION__);
+        return HAL_INVALID_ARGS;
+    }
+    auto lock = ReadLockData();
+    SetRegDomainCommand command(handle, country_code);
+    int ret = command.RequestResponse();
+    if (ret < 0) {
+        HDF_LOGE("%{public}s: set reg domain %{public}s failed, ret %{public}d",
+            __FUNCTION__, country_code, ret);
+        return (WifiError)ret;
+    }
+    HDF_LOGI("%{public}s}: regulatory domain set to %{public}s", __FUNCTION__, country_code);
+    return HAL_SUCCESS;
+}
+
+static WifiError WifiDisablePowerSave(wifiInterfaceHandle handle)
+{
+    if (!handle) {
+        HDF_LOGE("%{public}s: handle is null", __FUNCTION__);
+        return HAL_INVALID_ARGS;
+    }
+    auto lock = ReadLockData();
+    SetPowerSaveCommand command(handle);
+    int ret = command.RequestResponse();
+    if (ret < 0) {
+        /* Not fatal: some drivers do not implement the command. */
+        HDF_LOGW("%{public}s}: disable power save failed, ret %{public}d", __FUNCTION__, ret);
+        return (WifiError)ret;
+    }
+    HDF_LOGI("%{public}s}: power save disabled", __FUNCTION__);
+    return HAL_SUCCESS;
+}
+
+static WifiError WifiReloadRegDb(wifiHandle handle)
+{
+    if (!handle) {
+        HDF_LOGE("%{public}s: handle is null", __FUNCTION__);
+        return HAL_INVALID_ARGS;
+    }
+    auto lock = ReadLockData();
+    ReloadRegDbCommand command(handle);
+    int ret = command.RequestResponse();
+    if (ret < 0) {
+        HDF_LOGW("%{public}s}: reload regulatory.db failed (ret %{public}d), "
+            "the kernel keeps the built-in world domain", __FUNCTION__, ret);
+        return (WifiError)ret;
+    }
+    HDF_LOGI("%{public}s}: regulatory.db reloaded", __FUNCTION__);
+    return HAL_SUCCESS;
