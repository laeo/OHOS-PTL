diff --git a/battery/interfaces/hdi_service/src/power_supply_provider.cpp b/battery/interfaces/hdi_service/src/power_supply_provider.cpp
index 2ea41ac60..5695700cc 100644
--- a/battery/interfaces/hdi_service/src/power_supply_provider.cpp
+++ b/battery/interfaces/hdi_service/src/power_supply_provider.cpp
@@ -58,6 +58,51 @@ const std::string INVALID_STRING_VALUE = "invalid";
 const std::string BATTERY_NODE_PATH = "battery";
 const std::string BATTERY_LESS_DTS_PATH = "/proc/device-tree/power_host_cfg/battery_less";
 const std::string BATTERY_LESS_PRODUCT = "1";
+const std::string BATTERY_TYPE_NAME = "Battery";
+const std::string POWER_SUPPLY_TYPE_NODE = "type";
+
+// Scan /sys/class/power_supply for a real battery node (e.g. ACPI BAT0) whose
+// "type" reads "Battery". Returns the node name, or empty when none is present.
+std::string FindBatteryNodeByType()
+{
+    DIR* dir = opendir(POWER_SUPPLY_BASE_PATH.c_str());
+    if (dir == nullptr) {
+        return "";
+    }
+    std::string result;
+    struct dirent* entry = nullptr;
+    while ((entry = readdir(dir)) != nullptr) {
+        if (strcmp(entry->d_name, ".") == 0 || strcmp(entry->d_name, "..") == 0) {
+            continue;
+        }
+        if (entry->d_type != DT_DIR && entry->d_type != DT_LNK) {
+            continue;
+        }
+        std::string typePath = POWER_SUPPLY_BASE_PATH + "/" + entry->d_name + "/" + POWER_SUPPLY_TYPE_NODE;
+        int32_t fd = open(typePath.c_str(), O_RDONLY);
+        if (fd < 0) {
+            continue;
+        }
+        char buf[MAX_BUFF_SIZE] = {0};
+        ssize_t size = read(fd, buf, sizeof(buf) - 1);
+        close(fd);
+        if (size <= 0) {
+            continue;
+        }
+        buf[size] = '\0';
+        std::string type(buf);
+        size_t pos = type.find_first_of("\r\n");
+        if (pos != std::string::npos) {
+            type = type.substr(0, pos);
+        }
+        if (type == BATTERY_TYPE_NAME) {
+            result = entry->d_name;
+            break;
+        }
+    }
+    closedir(dir);
+    return result;
+}
 }
 
 BatterydInfo g_batteryInfo;
@@ -595,6 +640,13 @@ void PowerSupplyProvider::InitBatteryPath()
             BATTERY_HILOGI(FEATURE_BATT_INFO, "system Battery path is exist");
             return;
         }
+        std::string realBatteryNode = FindBatteryNodeByType();
+        if (!realBatteryNode.empty()) {
+            BATTERY_HILOGI(FEATURE_BATT_INFO,
+                "find real ACPI battery node %{public}s, use /sys/class/power_supply instead of mock",
+                realBatteryNode.c_str());
+            return;
+        }
         InitDefaultSysfs();
     }
     InitChargerSysfs();
