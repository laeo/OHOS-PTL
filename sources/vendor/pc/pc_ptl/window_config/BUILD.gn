import("//build/ohos.gni")

# Real-hardware DPI override for the Panther Lake panel (3072x1920, 350x220 mm
# -> ~223 PPI).  Installed into /sys_prod/etc/window/resources/, which
# GetOneCfgFile() prefers over the /system default from vendor/ohemu/virt.
# Only display_manager_config is overridden here; the shared
# window_manager_config.xml from vendor/ohemu/virt stays in use.
ohos_prebuilt_etc("display_manager_config") {
  source = "display_manager_config.xml"
  install_images = [ sys_prod_base_dir ]
  relative_install_dir = "window/resources"
  subsystem_name = "product_pc_ptl"
  part_name = "product_pc_ptl"
}

group("window_config") {
  deps = [
    ":display_manager_config",
  ]
}
