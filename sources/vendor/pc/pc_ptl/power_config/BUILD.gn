import("//build/ohos.gni")

# Reuse the QEMU virt power profile (auto-suspend times, etc.).  Real-hardware
# tuning (backlight / lid / thermal) is a later task.
ohos_prebuilt_etc("power_mode_config") {
  source = "power_mode_config.xml"
  subsystem_name = "product_pc_ptl"
  relative_install_dir = "power_config"
  part_name = "product_pc_ptl"
}
