+      const columns: number = res.mColumns ?? this.mGridLayoutInfo.layoutDescription.column;
+      const maxPage: number = this.mGridLayoutInfo.layoutDescription.maxPage > 0 ?
+        this.mGridLayoutInfo.layoutDescription.maxPage : 18;
