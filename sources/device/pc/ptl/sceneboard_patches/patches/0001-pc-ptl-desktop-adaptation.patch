+
+// PC taskbar input-method indicator (Windows / macOS style).
+// - Shows the active IME / Rime schema + Chinese/English and an A/a CapsLock badge.
+//   The Simplified/Traditional badge is hidden by default to keep the indicator
+//   compact; set the system parameter `persist.scb.ime.show_traditional=true` to
+//   pin it. Toggling Simplified/Traditional still raises a toast either way.
+// - Subscribes to the public event 'com.ohos.rimeime.STATE' published by the
+//   com.ohos.rimeime IME and raises a toast when the state changes.
+// - Input-method switching no longer happens on left click: left click is a **no-op**
+//   (the indicator is status display only), right click opens a native ArkUI Menu
+//   ("切换输入法 / 输入法与语言设置 / Rime 设置") anchored right above the indicator.
+//   "切换输入法" hands over to the system Settings app on the "语言和输入法" page (the
+//   single place where the user switches/enables IMEs). The old system chooser dialog
+//   (com.ohos.inputmethodchoosedialog) is not reachable from the dock because a
+//   desktop-level modal that can be dismissed only by picking an IME is a trap.
+import { LogDomain, LogHelper } from '@ohos/basicutils';
+import inputMethod from '@ohos.inputMethod';
+import InputMethodSubtype from '@ohos.InputMethodSubtype';
+import commonEventManager from '@ohos.commonEventManager';
+import type { BusinessError } from '@ohos.base';
+import common from '@ohos.app.ability.common';
+import type Want from '@ohos.app.ability.Want';
+import { promptAction, SymbolGlyphModifier } from '@kit.ArkUI';
+import { systemParameterEnhance } from '@kit.BasicServicesKit';
+
+const TAG = 'ImeIndicator';
+const log: LogHelper = LogHelper.getLogHelper(LogDomain.HOME, TAG);
+const INDICATOR_HEIGHT: number = 28;
+const STATE_EVENT: string = 'com.ohos.rimeime.STATE';
+const RIME_BUNDLE: string = 'com.ohos.rimeime';
+const RIME_SETTINGS_ABILITY: string = 'RimeSettingsAbility';
+const RIME_MODULE: string = 'entry';
+// The system Settings app is the one and only place for switching / enabling IMEs.
+const SETTINGS_BUNDLE: string = 'com.ohos.settings';
+const SETTINGS_ABILITY: string = 'com.ohos.settings.MainAbility';
+// The Settings app routes by NavEntryKey, NOT by page url: MainAbility.uriChangeProcess
+// (product/phone/src/main/ets/MainAbility/MainAbility.ets:206) only translates the
+// `settings://xxx` link map, and Navigation.navDestination looks the target up in
+// DynamicLoader.loaderMap, which is keyed by NavEntryKey ('set_input' =
+// common/src/main/ets/utils/Consts.ets:77). Passing the url 'pages/input/InputSettings'
+// creates an empty NavDestination: "DynamicLoader: Page Load Failure" +
+// "AceNavigation: can't find name in config file" -> a blank page with only a back arrow.
+const SETTINGS_INPUT_URI: string = 'set_input';
+// Optional config: when set to 'true', the indicator keeps the 简/繁 badge visible.
+const SHOW_TRADITIONAL_PARAM: string = 'persist.scb.ime.show_traditional';
+
+interface RimeStateParams {
+  schema?: string;
+  schemaLabel?: string;
+  chinese?: boolean;
+  traditional?: boolean;
+  capsLock?: boolean;
+}
+
+@Component
+export struct ImeIndicatorComponent {
+  @Prop contentColor: string = '#FFFFFF';
+  @State imeLabel: string = '';
+  @State schemaLabel: string = '';
+  @State chinese: boolean = true;
+  @State traditional: boolean = false;
+  @State capsLock: boolean = false;
+  @State isRime: boolean = false;
+  @State hasRimeState: boolean = false;
+  @State showTraditional: boolean = false;
+
+  private subscriber: commonEventManager.CommonEventSubscriber | undefined = undefined;
+  private subscribeInfo: commonEventManager.CommonEventSubscribeInfo = { events: [STATE_EVENT] };
+
+  // Native context menu anchored right above the indicator, with a frosted-glass
+  // background and rounded corners (standard ArkUI look & feel).
+  private menuOptions: ContextMenuOptions = {
+    placement: Placement.Top,
+    enableArrow: true,
+    borderRadius: 12,
+    offset: { x: 0, y: -6 },
+    backgroundBlurStyle: BlurStyle.COMPONENT_ULTRA_THICK
+  };
+
+  private listener: (p: inputMethod.InputMethodProperty, s: InputMethodSubtype) => void =
+    (p: inputMethod.InputMethodProperty, s: InputMethodSubtype): void => {
+      this.updateFromImf(p, s);
+    };
+
+  aboutToAppear(): void {
+    log.showInfo('ImeIndicatorComponent aboutToAppear');
+    this.loadDisplayConfig();
+    try {
+      inputMethod.getInputMethodSetting().on('imeChange', this.listener);
+    } catch (err) {
+      log.showError(`register imeChange failed: ${JSON.stringify(err)}`);
+    }
+    this.refresh();
+    this.subscribeRimeState();
+  }
+
+  aboutToDisappear(): void {
+    log.showInfo('ImeIndicatorComponent aboutToDisappear');
+    try {
+      inputMethod.getInputMethodSetting().off('imeChange', this.listener);
+    } catch (err) {
+      log.showError(`unregister imeChange failed: ${JSON.stringify(err)}`);
+    }
+    try {
+      if (this.subscriber !== undefined) {
+        commonEventManager.unsubscribe(this.subscriber);
+        this.subscriber = undefined;
+      }
+    } catch (err) {
+      log.showError(`unsubscribe STATE failed: ${JSON.stringify(err)}`);
+    }
+  }
+
+  private loadDisplayConfig(): void {
+    try {
+      this.showTraditional =
+        systemParameterEnhance.getSync(SHOW_TRADITIONAL_PARAM, 'false') === 'true';
+    } catch (err) {
+      log.showError(`loadDisplayConfig failed: ${JSON.stringify(err)}`);
+    }
+  }
+
+  private subscribeRimeState(): void {
+    commonEventManager.createSubscriber(this.subscribeInfo)
+      .then((subscriber: commonEventManager.CommonEventSubscriber) => {
+        this.subscriber = subscriber;
+        commonEventManager.subscribe(subscriber,
+          (err: BusinessError, data: commonEventManager.CommonEventData) => {
+          if (err && err.code) {
+            log.showError(`STATE subscribe failed: ${JSON.stringify(err)}`);
+            return;
+          }
+          this.onRimeState(data);
+        });
+      })
+      .catch((err: Object) => {
+        log.showError(`createSubscriber STATE failed: ${JSON.stringify(err)}`);
+      });
+  }
+
+  private onRimeState(data: commonEventManager.CommonEventData): void {
+    if (data === undefined || data.parameters === undefined) {
+      return;
+    }
+    let p = data.parameters as Record<string, Object>;
+    let schemaLabel: string = p['schemaLabel'] !== undefined ? p['schemaLabel'] as string : '';
+    let chinese: boolean = p['chinese'] !== undefined ? p['chinese'] as boolean : true;
+    let traditional: boolean = p['traditional'] !== undefined ? p['traditional'] as boolean : false;
+    let capsLock: boolean = p['capsLock'] !== undefined ? p['capsLock'] as boolean : false;
+    log.showInfo(`STATE schema=${schemaLabel} chinese=${chinese} trad=${traditional} caps=${capsLock}`);
+    // The common-event callback may run off the UI thread; marshal the state
+    // update (and toast) onto the UI thread so @State changes take effect.
+    try {
+      this.getUIContext().runScopedTask(() => {
+        this.applyRimeState(schemaLabel, chinese, traditional, capsLock);
+      });
+    } catch (err) {
+      log.showError(`runScopedTask failed: ${JSON.stringify(err)}`);
+      this.applyRimeState(schemaLabel, chinese, traditional, capsLock);
+    }
+  }
+
+  private applyRimeState(schemaLabel: string, chinese: boolean, traditional: boolean,
+    capsLock: boolean): void {
+    if (!this.hasRimeState) {
+      // First state after boot: adopt silently, no toast.
+      this.hasRimeState = true;
+      this.schemaLabel = schemaLabel;
+      this.chinese = chinese;
+      this.traditional = traditional;
+      this.capsLock = capsLock;
+      return;
+    }
+    if (schemaLabel !== this.schemaLabel && schemaLabel.length > 0) {
+      this.schemaLabel = schemaLabel;
+      this.toast('输入方案：' + schemaLabel);
+    }
+    if (chinese !== this.chinese) {
+      this.chinese = chinese;
+      this.toast(chinese ? '中文' : 'English');
+    }
+    if (traditional !== this.traditional) {
+      this.traditional = traditional;
+      this.toast(traditional ? '繁體' : '简体');
+    }
+    this.capsLock = capsLock;
+  }
+
+  private toast(message: string): void {
+    try {
+      promptAction.showToast({
+        message: message,
+        showMode: promptAction.ToastShowMode.TOP_MOST
+      });
+    } catch (err) {
+      log.showError(`showToast failed: ${JSON.stringify(err)}`);
+    }
+  }
+
+  private refresh(): void {
+    try {
+      let property: inputMethod.InputMethodProperty = inputMethod.getCurrentInputMethod();
+      let subtype: InputMethodSubtype = inputMethod.getCurrentInputMethodSubtype();
+      this.updateFromImf(property, subtype);
+    } catch (err) {
+      log.showError(`refresh failed: ${JSON.stringify(err)}`);
+    }
+  }
+
+  private updateFromImf(property: inputMethod.InputMethodProperty, subtype: InputMethodSubtype): void {
+    let label: string = this.pickLabel(property, subtype);
+    this.isRime = property !== undefined && property.name === RIME_BUNDLE;
+    log.showInfo(`ime label -> ${label} isRime=${this.isRime}`);
+    this.imeLabel = label;
+  }
+
+  private isValidLabel(value?: string): boolean {
+    return value !== undefined && value.length > 0 && value.charAt(0) !== '$';
+  }
+
+  private pickLabel(property: inputMethod.InputMethodProperty, subtype: InputMethodSubtype): string {
+    if (this.isValidLabel(subtype?.label)) {
+      return subtype.label as string;
+    }
+    if (this.isValidLabel(property?.label)) {
+      return property.label as string;
+    }
+    let language: string = subtype !== undefined ? subtype.language : '';
+    if (language.startsWith('zh')) {
+      return '中';
+    }
+    if (language.startsWith('en')) {
+      return 'EN';
+    }
+    if (property !== undefined && property.name !== undefined && property.name.length > 0) {
+      return property.name;
+    }
+    return 'IME';
+  }
+
+  // Main label: for Rime show "schema · 中/EN", otherwise the IMF label.
+  private mainLabel(): string {
+    if (this.schemaLabel.length > 0) {
+      return this.schemaLabel + ' · ' + (this.chinese ? '中' : 'EN');
+    }
+    return this.imeLabel.length > 0 ? this.imeLabel : 'IME';
+  }
+
+  // Menu entry "切换输入法": hand the user over to the system Settings app so that
+  // switching or enabling an IME is done in one obvious, standard place.
+  private openSettingsInputPage(): void {
+    log.showInfo('openSettingsInputPage');
+    try {
+      let context = getContext(this) as common.UIAbilityContext;
+      let want: Want = {
+        bundleName: SETTINGS_BUNDLE,
+        abilityName: SETTINGS_ABILITY,
+        uri: SETTINGS_INPUT_URI
+      };
+      context.startAbility(want).then(() => {
+        log.showInfo('startAbility settings input page ok');
+      }).catch((err: Object) => {
+        log.showError(`startAbility settings input page failed: ${JSON.stringify(err)}`);
+        this.toast('输入法切换：设置 → 语言和输入法');
+      });
+    } catch (err) {
+      log.showError(`openSettingsInputPage failed: ${JSON.stringify(err)}`);
+      this.toast('输入法切换：设置 → 语言和输入法');
+    }
+  }
+
+  private openRimeSettings(): void {
+    log.showInfo('openRimeSettings');
+    try {
+      let context = getContext(this) as common.UIAbilityContext;
+      let want: Want = {
+        bundleName: RIME_BUNDLE,
+        moduleName: RIME_MODULE,
+        abilityName: RIME_SETTINGS_ABILITY
+      };
+      context.startAbility(want).then(() => {
+        log.showInfo('startAbility RimeSettings ok');
+      }).catch((err: Object) => {
+        log.showError(`startAbility RimeSettings failed: ${JSON.stringify(err)}`);
+      });
+    } catch (err) {
+      log.showError(`openRimeSettings failed: ${JSON.stringify(err)}`);
+    }
+  }
+
+  @Builder
+  IndicatorMenu() {
+    Menu() {
+      MenuItem({
+        symbolStartIcon: new SymbolGlyphModifier($r('sys.symbol.globe_and_keyboard')),
+        content: '切换输入法'
+      })
+        .onClick(() => {
+          this.openSettingsInputPage();
+        })
+      MenuItem({
+        symbolStartIcon: new SymbolGlyphModifier($r('sys.symbol.gearshape')),
+        content: '输入法与语言设置'
+      })
+        .onClick(() => {
+          this.openSettingsInputPage();
+        })
+      MenuItem({
+        symbolStartIcon: new SymbolGlyphModifier($r('sys.symbol.keyboard_fill')),
+        content: 'Rime 设置'
+      })
+        .onClick(() => {
+          this.openRimeSettings();
+        })
+    }
+    .radius(14)
+    // No fixed width: the menu hugs its content so short labels never get a wide
+    // empty box and longer labels are never truncated.
+    .constraintSize({ minWidth: 176, maxWidth: 260 })
+  }
+
+  build() {
+    Row() {
+      Text(this.mainLabel())
+        .id('ScbSmartDock_ime_indicator')
+        .fontSize(12)
+        .fontColor(this.contentColor)
+        .fontWeight(FontWeight.Medium)
+        .textAlign(TextAlign.Center)
+        .maxLines(1)
+        .textOverflow({ overflow: TextOverflow.Ellipsis })
+        .constraintSize({ maxWidth: 110 })
+      if (this.schemaLabel.length > 0 && this.showTraditional) {
+        Text(this.traditional ? '繁' : '简')
+          .fontSize(10)
+          .fontColor(this.contentColor)
+          .opacity(0.7)
+          .margin({ left: 4 })
+      }
+      if (this.schemaLabel.length > 0) {
+        Text(this.capsLock ? 'A' : 'a')
+          .id('ScbSmartDock_ime_caps')
+          .fontSize(10)
+          .fontWeight(this.capsLock ? FontWeight.Bold : FontWeight.Normal)
+          .fontColor(this.contentColor)
+          .opacity(this.capsLock ? 1.0 : 0.5)
+          .margin({ left: 4 })
+      }
+    }
+    .constraintSize({ minWidth: 36, maxWidth: 140 })
+    .height(INDICATOR_HEIGHT)
+    .padding({ left: 8, right: 8 })
+    .borderRadius(6)
+    .backgroundColor('#22000000')
+    .margin({ right: 6 })
+    .hoverEffect(HoverEffect.Highlight)
+    // Left click is intentionally a no-op (user requirement): the indicator is a
+    // status display only. Switching an IME lives in the context menu ("切换输入法"),
+    // which hands over to the system Settings "语言和输入法" page.
+    .onClick(() => {
+      log.showInfo('left click ignored: use the context menu');
+    })
+    .bindContextMenu(this.IndicatorMenu(), ResponseType.RightClick, this.menuOptions)
+    .bindContextMenu(this.IndicatorMenu(), ResponseType.LongPress, this.menuOptions)
+  }
+}
