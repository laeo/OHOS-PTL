+
+/**
+ * 鸿蒙环（开始菜单）独立组件：
+ * 自带 contentColor provide，避免与 DockStatusBarComponent 的 @Provide 冲突；
+ * 点击弹出开始菜单（应用列表入口 + 电源）。
+ */
+@Component
+struct HarmonyRingEntry {
+  @Provide contentColor: string = '#000000';
+  @State ringMenuShow: boolean = false;
+
+  private ringOpenAppCenter(): void {
+    log.showInfo('harmony ring: open app center');
+    try {
+      if (viewMgrPolicy.isViewShowing(ViewType.APP_CENTER)) {
+        if (GlobalContext.getInstance().hasObject('hideAppCenterWithAnimation')) {
+          let hide = (GlobalContext.getInstance().getObject('hideAppCenterWithAnimation')) as Function;
+          hide(0);
+          return;
+        }
+      }
+    } catch (error) {
+      log.showError(`harmony ring app center error: ${error}`);
+    }
+    viewMgrPolicy.showView(ViewType.APP_CENTER);
+  }
+
+  private ringSleep(): void {
+    log.showInfo('harmony ring: sleep');
+    try {
+      power.suspend(true);
+    } catch (error) {
+      log.showError(`harmony ring sleep error: ${error}`);
+    }
+  }
+
+  private ringReboot(): void {
+    log.showInfo('harmony ring: reboot');
+    try {
+      power.reboot('reboot_by_user');
+    } catch (error) {
+      log.showError(`harmony ring reboot error: ${error}`);
+    }
+  }
+
+  private ringShutdown(): void {
+    log.showInfo('harmony ring: shutdown');
+    try {
+      power.shutdown('shutdown_by_user');
+    } catch (error) {
+      log.showError(`harmony ring shutdown error: ${error}`);
+    }
+  }
+
+  @Builder
+  ringMenuBuilder() {
+    Menu() {
+      MenuItem({ content: $r('app.string.dock_hover_text_appcenter') })
+        .onClick(() => this.ringOpenAppCenter())
+      MenuItem({ content: $r('app.string.sleep') })
+        .onClick(() => this.ringSleep())
+      MenuItem({ content: $r('app.string.reboot_device') })
+        .onClick(() => this.ringReboot())
+      MenuItem({ content: $r('app.string.shutdown_device') })
+        .onClick(() => this.ringShutdown())
+    }
+  }
+
+  build() {
+    Row() {
+      Column() {
+        HarmonyRingPage()
+      }
+      .width(48)
+      .height(48)
+      .justifyContent(FlexAlign.Center)
+      .alignItems(HorizontalAlign.Center)
+      .onClick(() => {
+        this.ringMenuShow = !this.ringMenuShow;
+      })
+      .bindPopup(this.ringMenuShow, {
+        builder: this.ringMenuBuilder(),
+        placement: Placement.Top,
+        mask: false,
+        enableArrow: false,
+        autoCancel: true,
+        showInSubWindow: true,
+        radius: StyleConstants.DEFAULT_8,
+        shadow: ShadowStyle.OUTER_DEFAULT_SM,
+        backgroundBlurStyle: BlurStyle.COMPONENT_REGULAR,
+        onStateChange: (e) => {
+          if (!e.isVisible) {
+            this.ringMenuShow = false;
+          }
+        }
+      })
+      .id('ScbSmartDock_harmony_ring')
+    }
+    .height('100%')
+    .justifyContent(FlexAlign.Center)
+    .alignItems(VerticalAlign.Center)
+  }
 }
