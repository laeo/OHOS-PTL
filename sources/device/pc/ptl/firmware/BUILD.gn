#
# Intel Panther Lake (X7-358H) firmware, captured from the host's
# /lib/firmware (linux-firmware) and decompressed from .zst so that the
# in-tree kernel (CONFIG_FW_LOADER_COMPRESS_ZSTD is NOT set) can load them.
#
# They are installed into BOTH:
#   * the ramdisk (`/lib/firmware`) so that built-in drivers (iwlwifi /
#     btintel_pcie are still =y) can load firmware during early boot, before the
#     system partition is mounted; and
#   * the system image (`/system/lib/firmware`), which the OHOS sandbox exposes
#     as `/lib/firmware` (`/lib -> /system/lib`) to services and to the kernel
#     modules (xe / i915 are =m) that OHOS init loads after switch_root.
#
# IMPORTANT (SOF / IPC4): the module_install_dir of every SOF file MUST carry
# the `intel/` prefix, because that is exactly the path the in-tree kernel
# asks the firmware loader for:
#   sound/soc/sof/intel/pci-ptl.c:42  default_fw_path  = "intel/sof-ipc4/ptl"
#   sound/soc/sof/intel/pci-ptl.c:45  default_lib_path = "intel/sof-ipc4-lib/ptl"
#   sound/soc/sof/intel/pci-ptl.c:48  default_tplg_path = "intel/sof-ipc4-tplg"
#   sound/soc/sof/intel/pci-ptl.c:51  default_fw_filename = "sof-ptl.ri"
#   sound/soc/sof/core.c:310          plat_data->fw_filename_prefix = fw_path
#   sound/soc/sof/ipc4-loader.c:296   split release libs: <prefix>/sof-ptl-openmodules.ri
# The kernel search roots are firmware_class.path (cmdline:
# /system/lib/firmware) then /lib/firmware
# (drivers/base/firmware_loader/main.c:471-478), so the files have to live at
#   <root>/intel/sof-ipc4/ptl/sof-ptl.ri
#   <root>/intel/sof-ipc4/ptl/sof-ptl-openmodules.ri
#   <root>/intel/sof-ipc4-tplg/<topology>.tplg
# Installing them without `intel/` (as this file used to do) makes the kernel
# look in a directory that does not exist -> no firmware, no sof-hda-dsp card.

import("//build/ohos.gni")
import("//device/pc/ptl/device.gni")

