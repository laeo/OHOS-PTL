import("//build/ohos.gni")
import("//device/pc/ptl/device.gni")

# init.cfg loads /vendor/etc/init.${ohos.boot.hardware}.cfg and
# /vendor/etc/fstab.${ohos.boot.hardware}; with `ohos.boot.hardware=pc_ptl`
# on the kernel cmdline these are init.pc_ptl.cfg / fstab.pc_ptl.

ohos_prebuilt_etc("init_pc_ptl_cfg") {
  source = "init.pc_ptl.cfg"
  install_images = [ vendor_base_dir ]
  module_install_dir = "etc"
  subsystem_name = pc_ptl_subsystem_name
  part_name = pc_ptl_part_name
}

ohos_prebuilt_etc("init_pc_ptl_usb_cfg") {
  source = "init.pc_ptl.usb.cfg"
  install_images = [ vendor_base_dir ]
  module_install_dir = "etc"
  subsystem_name = pc_ptl_subsystem_name
  part_name = pc_ptl_part_name
}

ohos_prebuilt_etc("fstab_pc_ptl") {
  source = "fstab.pc_ptl"
  install_images = [ vendor_base_dir ]
  module_install_dir = "etc"
  subsystem_name = pc_ptl_subsystem_name
  part_name = pc_ptl_part_name
}

group("pc_ptl_cfg") {
  deps = [
    ":fstab_pc_ptl",
    ":init_pc_ptl_cfg",
    ":init_pc_ptl_usb_cfg",
  ]
}
