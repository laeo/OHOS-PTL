# fstab for Intel Panther Lake (X7-358H) real hardware.
# Skeleton / NOT verified on hardware. Replace by-name labels / partition layout
# with the actual GPT created for the OHOS install.
#<src>                          <mnt_point>  <type>  <mnt_flags and options>                              <fs_mgr_flags>
/dev/block/by-name/system       /usr         ext4    ro,barrier=1                                         wait,required
/dev/block/by-name/vendor       /vendor      ext4    ro,barrier=1                                         wait,required
/dev/block/by-name/sys_prod     /sys_prod    ext4    ro,barrier=1                                         wait
/dev/block/by-name/chip_prod    /chip_prod   ext4    ro,barrier=1                                         wait
/dev/block/by-name/userdata     /data        ext4    nosuid,nodev,noatime,barrier=1,data=ordered,noauto_da_alloc wait,reservedsize=104857600
/dev/block/by-name/misc         /misc        none    none                                                 wait
