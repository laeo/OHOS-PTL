# Intel Panther Lake (Core Ultra X7-358H) real-hardware board.
#
# The board deliberately reuses the QEMU virt_full common device stack
# (kernel build, HDI hardware including the de-hardcoded display composer,
# image configuration, ...) so that the QEMU test bench and the real machine
# share one code path.  Only the board identity and the real-hardware
# specific bits (fstab, init, firmware) are provided here.
import("//device/qemu/common/virt_full/device.gni")

# Device part identity for this board.  These names are used by the
# device-side BUILD.gn files for the real-hardware extras.
pc_ptl_subsystem_name = "device_ptl"
pc_ptl_part_name = "pc_ptl_full"
