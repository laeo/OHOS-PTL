# truncate a long detail so the table stays readable
# NOTE: no 'tr' on the device - the details never contain a newline anyway
vtrunc() {
    printf '%s' "$1" | cut -c1-100
}

# vwidth <string> -> the number of terminal columns it occupies.
# LC_ALL is C here, so wc -c counts bytes.  A CJK character is 3 bytes and 2
# columns, everything else is 1 byte and 1 column:
#     columns = bytes - (bytes - ascii_bytes) / 3
vwidth() {
    _vw_b=$(printf '%s' "$1" | wc -c 2>/dev/null)
    case "$_vw_b" in ''|*[!0-9]*) _vw_b=0 ;; esac
    _vw_a=$(printf '%s' "$1" | sed 's/[^ -~]//g' 2>/dev/null | wc -c 2>/dev/null)
    case "$_vw_a" in ''|*[!0-9]*) _vw_a=0 ;; esac
    _vw_c=$(( (_vw_b - _vw_a) / 3 ))
    [ "$_vw_c" -lt 0 ] && _vw_c=0
    _vw_n=$(( _vw_b - _vw_c ))
    [ "$_vw_n" -lt 0 ] && _vw_n=0
    printf '%s' "$_vw_n"
}

# vpad <string> <width> -> the string padded to <width> terminal columns
vpad() {
    _vp_s=$1; _vp_w=$2
    _vp_n=$(vwidth "$_vp_s")
    _vp_k=$(( _vp_w - _vp_n ))
    [ "$_vp_k" -lt 0 ] && _vp_k=0
    _vp_p=""
    while [ "$_vp_k" -gt 0 ]; do
        _vp_p="$_vp_p "
        _vp_k=$(( _vp_k - 1 ))
    done
    printf '%s%s' "$_vp_s" "$_vp_p"
}

# build_verdict_table -> $W/VERDICT.txt
build_verdict_table() {
    _vt="$W/VERDICT.txt"
    _keys="$W/.vkeys"
    : > "$_keys" 2>/dev/null

    {
        echo "================================================================"
        echo " OHOS-DIAG VERDICT  --  pc_ptl (Intel PTL)"
        echo "================================================================"
        echo " 时间      : $(date 2>/dev/null)"
        echo " 主机      : $(uname -a 2>/dev/null)"
        echo " 运行时长  : $(cut -d. -f1 /proc/uptime 2>/dev/null)s"
        echo " 执行 section: $SECTIONS"
        if [ -r /system/etc/ohos-image-id ]; then
            echo " 镜像 ID   :"
            grep -v '^#' /system/etc/ohos-image-id 2>/dev/null | sed 's/^/              /'
        fi
        echo
        echo "列含义: PASS = 达到期望; FAIL = 未达到; WARN = 有问题但不致命;"
        echo "        SKIP = 该项无法判定(文件缺失/命令不存在/该 section 未运行)。"
        echo
        printf '%s | %s | %s | %s\n' "项目" "期望" "实测" "状态"
        printf '%s\n' '---------------------------------------------+----------------------------------+--------------------------------------------------+-------'
    } > "$_vt" 2>/dev/null

    _last_cat=""
    printf '%s\n' "$VSPEC" | while IFS='|' read -r _cat _key _what _exp; do
        case "$_key" in ''|'#'*) continue ;; esac
        printf '%s\n' "$_key" >> "$_keys" 2>/dev/null
        vlookup "$_key"
        if [ -n "$VLOOK_ST" ]; then
            _st=$VLOOK_ST
            _dt=$(vtrunc "$VLOOK_DT")
        else
            _st="SKIP"
            _dt="未采集 (section 未运行或数据缺失)"
        fi
        if [ "$_cat" != "$_last_cat" ]; then
            if [ -n "$_last_cat" ]; then
                printf '%s\n' '---------------------------------------------+----------------------------------+--------------------------------------------------+-------'
            fi
            printf '%s | %s | %s | %s\n' "[$_cat]" "" "" ""
            _last_cat=$_cat
        fi
        printf '%s | %s | %s | %s\n' "$(vpad "$_what" 43)" "$(vpad "$_exp" 32)" "$(vpad "$_dt" 50)" "$_st"
    done >> "$_vt" 2>/dev/null

    # anything that was checked but is not part of the table -> "其它"
    _extra="$W/.vextra"
    : > "$_extra" 2>/dev/null
    if [ -r "$VERDICT_TSV" ]; then
        while IFS='|' read -r _st _nm _dt; do
            if ! grep -qxF "$_nm" "$_keys" 2>/dev/null; then
                printf '%s|%s|%s\n' "$_st" "$_nm" "$_dt" >> "$_extra" 2>/dev/null
            fi
        done < "$VERDICT_TSV"
    fi
    if [ -s "$_extra" ]; then
        {
            printf '%s\n' '---------------------------------------------+----------------------------------+--------------------------------------------------+-------'
            printf '%s | %s | %s | %s\n' "[其它]" "" "" ""
            while IFS='|' read -r _st _nm _dt; do
                printf '%s | %s | %s | %s\n' "$(vpad "$_nm" 43)" "-" "$(vpad "$(vtrunc "$_dt")" 50)" "$_st"
            done < "$_extra"
        } >> "$_vt" 2>/dev/null
    fi
    rm -f "$_extra" "$_keys" 2>/dev/null

    {
        printf '%s\n' '---------------------------------------------+----------------------------------+--------------------------------------------------+-------'
        echo
        echo "汇总: PASS=$V_PASS  FAIL=$V_FAIL  WARN=$V_WARN  SKIP=$V_SKIP"
        echo
        echo "各 section 原始文件:"
        for f in "$W"/*.txt; do
            [ -f "$f" ] || continue
            b=$(basename "$f")
            case "$b" in VERDICT.txt) continue ;; esac
            printf '  %-28s %10s bytes\n' "$b" "$(wc -c < "$f" 2>/dev/null)"
        done
    } >> "$_vt" 2>/dev/null
}

# =============================================================================
# main
# =============================================================================
{
    echo "ohos-diag start"
    echo "  sections : $SECTIONS"
    echo "  outdir   : $OUTDIR"
    echo "  workdir  : $W"
    echo "  mode     : ${1:-all}"
    echo "  --- IMAGE ID (authoritative; /system/etc/ohos_build_id used to lie) ---"
    if [ -r /system/etc/ohos-image-id ]; then
        grep -v '^#' /system/etc/ohos-image-id | sed 's/^/  /'
    elif [ -r /vendor/etc/ohos-image-id ]; then
        grep -v '^#' /vendor/etc/ohos-image-id | sed 's/^/  /'
    else
        echo "  (no ohos-image-id -- this image predates the stamp)"
    fi
    echo "  --- legacy build_id file (NOT authoritative) ---"
    grep -v '^#' /system/etc/ohos_build_id 2>/dev/null | sed 's/^/  /'
    echo "  --- partition free space (p2 is nearly full on this product) ---"
    df -h / /vendor /data /sys_prod 2>/dev/null | sed 's/^/  /'
    echo "  --- legacy build id (may be stale) ---"
    sed 's/^/  /' /system/etc/ohos_build_id 2>/dev/null
    echo "  --- collector mount namespace ---"
    echo "  self: vendor=$(grep -c ' /vendor ' /proc/self/mountinfo 2>/dev/null) data=$(grep -c ' /data ' /proc/self/mountinfo 2>/dev/null)"
    echo "  pid1: vendor=$(grep -c ' /vendor ' /proc/1/mountinfo 2>/dev/null) data=$(grep -c ' /data ' /proc/1/mountinfo 2>/dev/null)"
    echo "  NOTE: self=0 with pid1>0 means this collector cannot see /vendor or /data;"
    echo "        aplay/amixer/bm/RDB/bt_vendor.log will all look broken because of it."
} | tee "$W/_header.txt"

want bootlog    && sec_bootlog
want fixes      && sec_fixes
want desktop    && sec_desktop
want bluetooth  && sec_bluetooth
want audio      && sec_audio
want audiotest  && sec_audiotest
want wifi       && sec_wifi
want media      && sec_media
want ime        && sec_ime
want perf       && sec_perf
want system     && sec_system
want hwdec      && sec_hwdec

# The table is the deliverable: one row per checked item.
build_verdict_table

# The verdict is only complete after the sections have run, so it is appended
# to the header now and printed to the console as well.
{
    echo
    echo "  ===== VERDICT TABLE (the summary - see VERDICT.txt in the bundle) ====="
    cat "$W/VERDICT.txt" 2>/dev/null
    echo
    echo "  ===== VERDICT (raw check list) ====="
    cat "$VERDICT" 2>/dev/null
    echo "  ------------------------------------------------------------"
    echo "  PASS=$V_PASS  FAIL=$V_FAIL  WARN=$V_WARN  SKIP=$V_SKIP"
} >> "$W/_header.txt" 2>/dev/null

echo
echo "===== VERDICT (VERDICT.txt) ====="
cat "$W/VERDICT.txt" 2>/dev/null
echo
echo "PASS=$V_PASS  FAIL=$V_FAIL  WARN=$V_WARN  SKIP=$V_SKIP"

# manifest of what was captured / what failed
{
    echo
    echo "===== MANIFEST ====="
    echo "sections requested: $SECTIONS"
    echo
    printf '%-24s %10s bytes  %6s lines\n' "VERDICT.txt" \
        "$(wc -c < "$W/VERDICT.txt" 2>/dev/null)" "$(wc -l < "$W/VERDICT.txt" 2>/dev/null)"
    for f in "$W"/*.txt; do
        [ -f "$f" ] || continue
        b=$(basename "$f")
        [ "$b" = "VERDICT.txt" ] && continue
        printf '%-24s %10s bytes  %6s lines\n' "$b" "$(wc -c < "$f")" "$(wc -l < "$f")"
    done
    echo
    echo "===== VERDICT ====="
    cat "$VERDICT" 2>/dev/null
    echo "PASS=$V_PASS  FAIL=$V_FAIL  WARN=$V_WARN  SKIP=$V_SKIP"
    echo
    echo "===== COMMAND LOG (rc=nonzero means that item failed) ====="
    cat "$W/_commands.log" 2>/dev/null
} > "$W/_manifest.txt" 2>&1

# sync before packing so a USB stick really has the bytes
sync -f "$OUTDIR" 2>/dev/null || sync 2>/dev/null || true

rm -f "$ARCHIVE" 2>/dev/null
if have tar; then
    # VERDICT.txt has to be the FIRST entry of the archive: the operator pulls
    # exactly one file out of the bundle and reads that.
    #   try: explicit member list (VERDICT.txt first, everything else after)
    #   fall back to: VERDICT.txt then the whole directory
    _MEMBERS=""
    if [ -d "$W" ]; then
        # the bundle file names never contain spaces or globs
        for _m in $( cd "$W" && ls -A 2>/dev/null ); do
            [ "$_m" = "VERDICT.txt" ] && continue
            _MEMBERS="$_MEMBERS $_m"
        done
    fi
    _OK=0
    if [ -n "$_MEMBERS" ]; then
        # VERDICT.txt first, then everything else - explicit member list, because
        # the toybox tar on the device has no -T
        if tar -czf "$ARCHIVE.$$" -C "$W" VERDICT.txt $_MEMBERS 2>/dev/null; then
            _OK=1
        fi
    fi
    if [ "$_OK" = 0 ]; then
        rm -f "$ARCHIVE.$$" 2>/dev/null
        if tar -czf "$ARCHIVE.$$" -C "$W" VERDICT.txt -C "$W" . 2>/dev/null; then
            _OK=1
        fi
    fi
    if [ "$_OK" = 1 ]; then
        mv -f "$ARCHIVE.$$" "$ARCHIVE" 2>/dev/null || cp -f "$ARCHIVE.$$" "$ARCHIVE" 2>/dev/null
    else
        rm -f "$ARCHIVE.$$" 2>/dev/null
        tar -cf - -C "$W" . 2>/dev/null | gzip > "$ARCHIVE" 2>/dev/null
    fi
fi
sync -f "$OUTDIR" 2>/dev/null || sync 2>/dev/null || true

# prune: keep the newest KEEP_N archives (ls -t, oldest first)
if [ "$KEEP_N" -gt 0 ] 2>/dev/null; then
    ls -t "$OUTDIR"/diag-*.tar.gz 2>/dev/null | tail -n "+$((KEEP_N + 1))" \
        | while IFS= read -r old; do rm -f "$old" 2>/dev/null; done
fi

rm -rf "$W" 2>/dev/null

if [ -f "$ARCHIVE" ]; then
    SZ=$(wc -c < "$ARCHIVE" 2>/dev/null)
    echo "ohos-diag: DONE, archive = $ARCHIVE ($SZ bytes)"
    echo "ohos-diag: 已完成，文件在 $ARCHIVE"
    echo "ohos-diag: 取包 (在 PC 上): hdc file recv $ARCHIVE ."
    echo "ohos-diag: 总览: tar -xzOf $ARCHIVE VERDICT.txt"
    printf '%s\n' "$ARCHIVE"
    exit 0
fi
echo "ohos-diag: FAILED (cannot create $ARCHIVE); raw data left in $W"
exit 1