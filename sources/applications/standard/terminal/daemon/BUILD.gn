import("//build/ohos.gni")

_terminal_subsystem = "applications"
_terminal_part = "pc_terminal"
_terminal_images = [ system_base_dir ]

# ---------------------------------------------------------------------------
# PTY broker daemon -> /system/bin/ohosshd
#
# The daemon itself is a plain OHOS (musl) dynamic binary; it is the broker that
# chroots + execs Alpine userland for each session.
# ---------------------------------------------------------------------------
ohos_executable("ohosptyd") {
  sources = [ "ohosptyd.c" ]
  output_name = "ohosshd"
  cflags = [
    "-D_FILE_OFFSET_BITS=64",
    "-Wall",
    "-Wno-unused-parameter",
  ]
  sanitize = {
    debug = false
    address = false
    cfi = false
    cfi_cross_dso = false
  }
  subsystem_name = _terminal_subsystem
  part_name = _terminal_part
  module_install_dir = "bin"
  install_images = _terminal_images
  install_enable = true
}

# ---------------------------------------------------------------------------
# Minimal setuid-root helper -> /system/bin/sudo
#
# It has to live on a partition mounted *without* nosuid, hence the read-only
# system partition.  Built non-PIE so the setuid image stays a plain ELF.
# ---------------------------------------------------------------------------
ohos_executable("sudoh") {
  sources = [ "sudoh.c" ]
  output_name = "sudo"
  remove_configs = [ "//build/config:executable_config" ]
  cflags = [
    "-fno-pie",
    "-Wall",
    "-Wno-unused-parameter",
  ]
  ldflags = [ "-Wl,-z,relro,-z,now" ]
  sanitize = {
    debug = false
    address = false
    cfi = false
    cfi_cross_dso = false
  }
  subsystem_name = _terminal_subsystem
  part_name = _terminal_part
  module_install_dir = "bin"
  install_images = _terminal_images
  install_enable = true
}

group("pc_terminal_daemon") {
  deps = [
    ":ohosptyd",
    ":sudoh",
  ]
}