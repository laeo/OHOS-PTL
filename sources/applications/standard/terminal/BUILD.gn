import("//build/ohos.gni")

_terminal_subsystem = "applications"
_terminal_part = "pc_terminal"

ohos_prebuilt_etc("terminal_ohosshd_cfg") {
  source = "init/ohosshd.cfg"
  subsystem_name = _terminal_subsystem
  part_name = _terminal_part
  install_images = [ system_base_dir ]
  module_install_dir = "etc/init"
}

group("pc_terminal") {
  deps = [
    ":terminal_ohosshd_cfg",
    "//applications/standard/terminal/daemon:pc_terminal_daemon",
  ]
}